# Copier vers .deploy.env puis renseigner les valeurs réelles.
# Alias de ~/.ssh/config ou utilisateur@adresse-du-mac-mini.
REMOTE_HOST='sofia@192.168.0.94'
# Dossier absolu existant sur le serveur, contenant le .env de production.
REMOTE_DIR='/Users/sofia/Sites/foyra-project'
# Nom du projet Docker Compose sur le serveur. Jamais « foyra » : c'est celui de l'autre application.
REMOTE_PROJECT='foyra-project'
