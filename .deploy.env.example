# Copier vers .deploy.env puis renseigner les valeurs réelles.
# Alias de ~/.ssh/config ou utilisateur@hote.
REMOTE_HOST='deploy@serveur.example.org'
# Dossier absolu existant sur le serveur, contenant le .env de production.
REMOTE_DIR='/srv/foyra'
# Nom du projet Docker Compose sur le serveur (minuscules, chiffres, - ou _).
# Doit être unique sur le serveur : le script refuse un projet appartenant à un autre dossier.
REMOTE_PROJECT='foyra'

# Image publiée à déployer (latest par défaut). Version ou digest recommandé pour figer une release.
# La variable passée à la commande reste prioritaire : DEPLOY_IMAGE=... make deploy-remote.
DEPLOY_IMAGE=${DEPLOY_IMAGE:-ghcr.io/okhachiai/foyra:latest}
