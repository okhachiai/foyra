generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TransactionKind {
  INCOME
  EXPENSE
}

// Création d'un budget mensuel : reprise des lignes récurrentes du budget précédent, ou modèles de catégories.
enum BudgetSource {
  PREVIOUS
  TEMPLATES
}

// Fournisseur LLM du rapport mensuel (clés et URL réglées par foyer dans Paramètres).
enum LlmProvider {
  CLAUDE
  LOCAL
}

enum ReportTrigger {
  MANUAL
  AUTO // cron : quotidien, et bilan du mois écoulé le 1er
}

// Quotidien : suivi du mois en cours ; MONTHLY : bilan prévu / réel du mois écoulé ; PLAN : répartition du reste sur les charges variables.
enum ReportKind {
  DAILY
  MONTHLY
  PLAN
}

enum BudgetStatus {
  DRAFT
  VALIDATED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Remboursement anticipé : réduire la durée (mensualité inchangée) ou la mensualité (fin inchangée).
enum PrepaymentMode {
  REDUCE_TERM
  REDUCE_PAYMENT
}

model Household {
  id           String       @id @default(cuid())
  name         String
  currency     String       @default("EUR")
  timezone     String       @default("Europe/Paris")
  budgetSource BudgetSource @default(PREVIOUS)
  llmProvider  LlmProvider? // préférence pour le rapport ; null = premier fournisseur configuré
  // Réglages LLM : un fournisseur n'est proposé que si ses champs sont renseignés (Claude : clé ; local : URL + modèle).
  claudeApiKey   String?
  claudeModel    String?
  localLlmUrl    String? // compatible OpenAI, sans /v1
  localLlmModel  String?
  localLlmApiKey String?
  createdAt    DateTime     @default(now())

  users         User[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  budgetItems   BudgetItem[]
  fixedCharges  FixedCharge[]
  fixedPayments FixedChargePayment[]
  loans         Loan[]
  prepayments   LoanPrepayment[]
  reports       Report[]
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  disabledAt   DateTime? // désactivé : connexion refusée, sessions supprimées ; réactivable
  createdAt    DateTime  @default(now())

  household     Household       @relation(fields: [householdId], references: [id])
  sessions      Session[]
  transactions  Transaction[]
  paid          Transaction[] @relation("PaidBy")
  reports       Report[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Opération réelle (recette / dépense), sans compte bancaire : `paidById` = membre qui a payé ou reçu.
model Transaction {
  id             String          @id @default(cuid())
  householdId    String
  createdById    String
  paidById       String
  kind           TransactionKind
  amount         Int
  occurredOn     DateTime        @db.Date
  note           String?
  categoryId     String?
  // Clé envoyée par le formulaire : une seconde soumission identique ne crée rien.
  idempotencyKey String?
  shared         Boolean         @default(true) // dépense commune / recette commune (partagées au prorata)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  household    Household           @relation(fields: [householdId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  paidBy       User                @relation("PaidBy", fields: [paidById], references: [id])
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fixedPayment FixedChargePayment?
  prepayment   LoanPrepayment?

  @@unique([householdId, idempotencyKey])
  @@index([householdId, occurredOn])
  @@index([paidById])
  @@index([categoryId])
}

// Catalogue et modèles de budget. Deux niveaux au plus (trigger SQL), sous-catégorie du même sens que son parent (FK composite).
// Archivée : absente des nouveaux budgets et des nouvelles saisies, conservée sur l'historique.
// Nom unique par (foyer, parent), insensible à la casse : index SQL brut dans la migration.
model Category {
  id             String       @id @default(cuid())
  householdId    String
  parentId       String?
  kind           CategoryKind
  name           String
  enabled        Boolean      @default(true) // « Inclure dans le calcul » par défaut
  recurring      Boolean      @default(true) // « Reprendre le mois suivant » par défaut
  isTemplate     Boolean      @default(true) // utilisée quand un budget part des modèles
  sortOrder      Int          @default(0)
  fixed          Boolean      @default(false) // dépense de premier niveau : charge fixe (factures…) ou variable (courses…) ; les sous-catégories suivent leur parent
  savings        Boolean      @default(false) // dépense de premier niveau « Épargne » : déduite des revenus comme une charge, suivie sur /epargne
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  parent       Category?     @relation("CategoryTree", fields: [parentId, householdId, kind], references: [id, householdId, kind], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetItems  BudgetItem[]
  fixedCharges FixedCharge[]

  @@unique([id, householdId, kind])
  @@index([householdId])
  @@index([parentId])
}

// Budget prévisionnel d'un mois (au plus un par foyer et par mois). Ne crée jamais d'opération.
model Budget {
  id          String       @id @default(cuid())
  householdId String
  month       DateTime     @db.Date // 1er du mois (CHECK SQL)
  status      BudgetStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  household Household    @relation(fields: [householdId], references: [id])
  items     BudgetItem[]
  reports   Report[]

  @@unique([householdId, month])
}

// Ligne d'un budget : copie indépendante (libellé, montant…) ; `categoryId` ne sert qu'à rapprocher le réel.
// Un seul niveau de sous-lignes (trigger SQL), même budget et même sens que le parent (FK composite).
// Une ligne avec enfants vaut la somme de ses enfants inclus ; son montant direct reste 0.
model BudgetItem {
  id          String       @id @default(cuid())
  householdId String
  budgetId    String
  parentId    String?
  categoryId  String?
  kind        CategoryKind
  label       String
  amount      Int          @default(0) // centimes >= 0 (CHECK SQL)
  included    Boolean      @default(true)
  recurring   Boolean      @default(true)
  sortOrder   Int          @default(0)
  shared      Boolean      @default(true) // ligne commune (partagée au prorata)
  // Une seule réserve par budget : index unique partiel "BudgetItem_one_reserve" écrit à la main (migration 20261105000000_shared_split),
  // inexprimable en Prisma ; toute migration générée qui le supprime doit être corrigée à la main.
  reserve     Boolean      @default(false) // ligne « Réserve imprévus »
  createdAt   DateTime     @default(now())

  household Household    @relation(fields: [householdId], references: [id])
  budget    Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent    BudgetItem?  @relation("BudgetItemTree", fields: [parentId, budgetId, kind], references: [id, budgetId, kind], onDelete: Cascade)
  children  BudgetItem[] @relation("BudgetItemTree")
  category  Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([id, budgetId, kind])
  @@index([budgetId])
  @@index([parentId])
  @@index([categoryId])
}

// Récurrence mensuelle : échéance indicative, sans montant (lu sur la ligne du budget du mois de même catégorie), s'applique au mois M si active et startMonth <= M <= endMonth.
// Ne crée jamais de paiement toute seule : « marquer payée » crée l'opération sur action explicite.
model FixedCharge {
  id          String       @id @default(cuid())
  householdId String
  kind        CategoryKind @default(EXPENSE)
  active      Boolean      @default(true)
  name        String
  dueDay      Int // 1–31 (CHECK SQL) ; échéance = min(jour, dernier jour du mois)
  categoryId  String
  startMonth  DateTime     @db.Date // 1er du mois (CHECK SQL)
  endMonth    DateTime?    @db.Date // 1er du mois, >= startMonth (CHECK SQL)
  shared      Boolean      @default(true) // charge commune (partagée au prorata)
  createdAt   DateTime     @default(now())

  household Household            @relation(fields: [householdId], references: [id])
  category  Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments  FixedChargePayment[]
  loan      Loan?

  @@index([householdId])
}

// Paiement d'une charge pour un mois : lié à la dépense créée ; supprimer la dépense supprime le paiement.
model FixedChargePayment {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String
  month         DateTime @db.Date // 1er du mois (CHECK SQL)
  transactionId String   @unique
  createdAt     DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([fixedChargeId, month])
  @@index([householdId, month])
}

// Crédit amortissable : porté par une charge fixe (nom, catégorie, jour, période) ; échéancier calculé, jamais stocké.
model Loan {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String   @unique
  principal     Int // centimes, > 0 (CHECK SQL)
  annualRate    Int // millièmes de pour cent : 3,450 % → 3450 ; 0–50 000 (CHECK SQL)
  termMonths    Int // 1–600 échéances mensuelles (CHECK SQL)
  payment       Int? // mensualité saisie (hors assurance), > 0 (CHECK SQL) ; null = annuité calculée
  insurance     Int      @default(0) // assurance mensuelle, centimes, >= 0 (CHECK SQL)
  createdAt     DateTime @default(now())

  household   Household        @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge      @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  prepayments LoanPrepayment[]

  @@index([householdId])
}

// Remboursement anticipé : montant et date lus sur la dépense liée ; supprimer la dépense l'annule.
model LoanPrepayment {
  id            String         @id @default(cuid())
  householdId   String
  loanId        String
  transactionId String         @unique
  mode          PrepaymentMode
  createdAt     DateTime       @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

// Rapport LLM d'un budget : `input` = chiffres envoyés, `output` = rapport validé, `error` si l'appel a échoué.
// Un seul rapport AUTO par foyer, jour et type (index partiel SQL « Report_one_auto » sur (householdId, day, kind) WHERE trigger = 'AUTO').
model Report {
  id          String        @id @default(cuid())
  householdId String
  budgetId    String
  userId      String? // auteur d'un rapport manuel
  day         DateTime      @db.Date
  kind        ReportKind
  trigger     ReportTrigger
  provider    LlmProvider
  model       String
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}
