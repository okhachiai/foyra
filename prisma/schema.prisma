generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum AccountKind {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

// Sens d'une ligne de virement : OUT débite le compte, IN le crédite.
enum TransferSide {
  OUT
  IN
}

// Accès d'un membre à un compte ; absence de ligne = aucun accès. L'admin a toujours accès à tout.
enum AccessLevel {
  READ
  WRITE
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Remboursement anticipé : réduire la durée (mensualité inchangée) ou la mensualité (fin inchangée).
enum PrepaymentMode {
  REDUCE_TERM
  REDUCE_PAYMENT
}

// Règle de reconduction du prévisionnel d'un mois sur l'autre (appliquée par le cycle budget).
enum CarryOver {
  PREVIOUS // reprendre le montant du mois précédent
  FORECAST // repartir du prévisionnel
  NONE // à saisir chaque mois
}

model Household {
  id        String   @id @default(cuid())
  // Un seul foyer par instance : la colonne unique (+ CHECK = true) empêche un second setup concurrent.
  singleton Boolean  @unique @default(true)
  name      String
  currency  String   @default("EUR")
  timezone  String   @default("Europe/Paris")
  createdAt DateTime @default(now())

  users         User[]
  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  budgetLines   BudgetLine[]
  fixedCharges  FixedCharge[]
  fixedPayments FixedChargePayment[]
  loans         Loan[]
  prepayments   LoanPrepayment[]
}

model User {
  id           String   @id @default(cuid())
  householdId  String
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  disabledAt   DateTime? // désactivé : connexion refusée, sessions supprimées ; réactivable
  createdAt    DateTime @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  sessions      Session[]
  transactions  Transaction[]
  accountAccess AccountAccess[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String      @id @default(cuid())
  householdId    String
  kind           AccountKind
  name           String
  initialBalance Int         @default(0)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  transactions Transaction[]
  fixedCharges FixedCharge[]
  access       AccountAccess[]

  @@index([householdId])
}

model AccountAccess {
  userId    String
  accountId String
  level     AccessLevel

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

model Transaction {
  id           String          @id @default(cuid())
  householdId  String
  accountId    String
  createdById  String
  kind         TransactionKind
  amount       Int
  occurredOn   DateTime        @db.Date
  note         String?
  transferId   String?
  transferSide TransferSide?
  categoryId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  household    Household           @relation(fields: [householdId], references: [id])
  account      Account             @relation(fields: [accountId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fixedPayment FixedChargePayment?
  prepayment   LoanPrepayment?

  @@unique([transferId, transferSide])
  @@index([accountId, occurredOn])
  @@index([householdId])
  @@index([categoryId])
}

// Deux niveaux au plus (catégorie › sous-catégorie) ; sens et parent fixés à la création.
// Une sous-catégorie n'entre dans le budget que si elle ET son parent sont activés.
// Nom unique par (foyer, parent), insensible à la casse : index SQL brut dans la migration.
model Category {
  id             String       @id @default(cuid())
  householdId    String
  parentId       String?
  kind           CategoryKind
  name           String
  forecastAmount Int? // centimes, >= 0 (CHECK SQL)
  carryOver      CarryOver    @default(FORECAST)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetLines  BudgetLine[]
  fixedCharges FixedCharge[]

  @@index([householdId])
  @@index([parentId])
}

// Montant prévu d'une catégorie pour un mois : créé à la première ouverture du mois (reconduction), jamais réécrit ensuite.
model BudgetLine {
  id          String   @id @default(cuid())
  householdId String
  categoryId  String
  month       DateTime @db.Date // 1er du mois (CHECK SQL)
  planned     Int? // centimes, >= 0 (CHECK SQL) ; null = à saisir
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([householdId, month])
}

// Charge fixe mensuelle : s'applique au mois M si startMonth <= M <= endMonth (endMonth vide = sans fin).
model FixedCharge {
  id          String    @id @default(cuid())
  householdId String
  name        String
  amount      Int // centimes, > 0 (CHECK SQL)
  dueDay      Int // 1–31 (CHECK SQL) ; échéance = min(jour, dernier jour du mois)
  accountId   String
  categoryId  String
  startMonth  DateTime  @db.Date // 1er du mois (CHECK SQL)
  endMonth    DateTime? @db.Date // 1er du mois, >= startMonth (CHECK SQL)
  createdAt   DateTime  @default(now())

  household Household            @relation(fields: [householdId], references: [id])
  account   Account              @relation(fields: [accountId], references: [id])
  category  Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments  FixedChargePayment[]
  loan      Loan?

  @@index([householdId])
}

// Paiement d'une charge pour un mois : lié à la dépense créée ; supprimer la dépense supprime le paiement.
model FixedChargePayment {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String
  month         DateTime @db.Date // 1er du mois (CHECK SQL)
  transactionId String   @unique
  createdAt     DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([fixedChargeId, month])
  @@index([householdId, month])
}

// Crédit amortissable : porté par une charge fixe (nom, compte, catégorie, jour, période) ; échéancier calculé, jamais stocké.
model Loan {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String   @unique
  principal     Int // centimes, > 0 (CHECK SQL)
  annualRate    Int // millièmes de pour cent : 3,450 % → 3450 ; 0–50 000 (CHECK SQL)
  termMonths    Int // 1–600 échéances mensuelles (CHECK SQL)
  payment       Int? // mensualité saisie (hors assurance), > 0 (CHECK SQL) ; null = annuité calculée
  insurance     Int      @default(0) // assurance mensuelle, centimes, >= 0 (CHECK SQL)
  createdAt     DateTime @default(now())

  household   Household        @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge      @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  prepayments LoanPrepayment[]

  @@index([householdId])
}

// Remboursement anticipé : montant et date lus sur la dépense liée ; supprimer la dépense l'annule.
model LoanPrepayment {
  id            String         @id @default(cuid())
  householdId   String
  loanId        String
  transactionId String         @unique
  mode          PrepaymentMode
  createdAt     DateTime       @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([loanId])
}
