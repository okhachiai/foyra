generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum AccountKind {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

// Sens d'une ligne de virement : OUT débite le compte, IN le crédite.
enum TransferSide {
  OUT
  IN
}

// Accès explicite d'un utilisateur à un compte ; absence de ligne = aucun accès (le rôle admin n'en donne aucun).
// MANAGE : modifier, archiver et régler le partage du compte.
enum AccessLevel {
  READ
  WRITE
  MANAGE
}

// HOUSEHOLD : tout utilisateur du foyer a au moins l'écriture ; SELECTED : seuls les accès explicites comptent.
enum AccountSharing {
  HOUSEHOLD
  SELECTED
}

// Création d'un budget mensuel : reprise des lignes récurrentes du budget précédent, ou modèles de catégories.
enum BudgetSource {
  PREVIOUS
  TEMPLATES
}

// Fournisseur LLM du rapport mensuel (clés et URL en variables d'environnement).
enum LlmProvider {
  CLAUDE
  LOCAL
}

enum ReportTrigger {
  MANUAL
  DAILY
}

enum BudgetStatus {
  DRAFT
  VALIDATED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Remboursement anticipé : réduire la durée (mensualité inchangée) ou la mensualité (fin inchangée).
enum PrepaymentMode {
  REDUCE_TERM
  REDUCE_PAYMENT
}

model Household {
  id           String       @id @default(cuid())
  name         String
  currency     String       @default("EUR")
  timezone     String       @default("Europe/Paris")
  budgetSource BudgetSource @default(PREVIOUS)
  llmProvider  LlmProvider? // préférence pour le rapport ; null = premier fournisseur configuré
  createdAt    DateTime     @default(now())

  users         User[]
  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  budgetItems   BudgetItem[]
  fixedCharges  FixedCharge[]
  fixedPayments FixedChargePayment[]
  loans         Loan[]
  prepayments   LoanPrepayment[]
  reports       Report[]
}

model User {
  id           String    @id @default(cuid())
  householdId  String
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  disabledAt   DateTime? // désactivé : connexion refusée, sessions supprimées ; réactivable
  createdAt    DateTime  @default(now())

  household     Household       @relation(fields: [householdId], references: [id])
  sessions      Session[]
  transactions  Transaction[]
  accountAccess AccountAccess[]
  ownedAccounts Account[]       @relation("AccountOwner")
  reports       Report[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String         @id @default(cuid())
  householdId    String
  kind           AccountKind
  name           String
  initialBalance Int            @default(0) // fixé à la création
  notes          String         @default("")
  sharing        AccountSharing @default(SELECTED)
  archivedAt     DateTime?
  ownerId        String? // null = compte commun (joint) ; distinct des droits
  createdAt      DateTime       @default(now())

  household    Household       @relation(fields: [householdId], references: [id])
  owner        User?           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  fixedCharges FixedCharge[]
  access       AccountAccess[]

  @@index([householdId])
  @@index([ownerId])
}

model AccountAccess {
  userId    String
  accountId String
  level     AccessLevel

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

model Transaction {
  id             String          @id @default(cuid())
  householdId    String
  accountId      String
  createdById    String
  kind           TransactionKind
  amount         Int
  occurredOn     DateTime        @db.Date
  note           String?
  transferId     String?
  transferSide   TransferSide?
  categoryId     String?
  // Clé envoyée par le formulaire : une seconde soumission identique ne crée rien (côté OUT pour un virement).
  idempotencyKey String?
  shared         Boolean         @default(true) // dépense commune ; forcé true sur un compte commun
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  household    Household           @relation(fields: [householdId], references: [id])
  account      Account             @relation(fields: [accountId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fixedPayment FixedChargePayment?
  prepayment   LoanPrepayment?

  @@unique([transferId, transferSide])
  @@unique([householdId, idempotencyKey])
  @@index([accountId, occurredOn])
  @@index([householdId])
  @@index([categoryId])
}

// Catalogue et modèles de budget. Deux niveaux au plus (trigger SQL), sous-catégorie du même sens que son parent (FK composite).
// Archivée : absente des nouveaux budgets et des nouvelles saisies, conservée sur l'historique.
// Nom unique par (foyer, parent), insensible à la casse : index SQL brut dans la migration.
model Category {
  id             String       @id @default(cuid())
  householdId    String
  parentId       String?
  kind           CategoryKind
  name           String
  forecastAmount Int          @default(0) // montant par défaut des nouveaux budgets, centimes >= 0 (CHECK SQL)
  enabled        Boolean      @default(true) // « Inclure dans le calcul » par défaut
  recurring      Boolean      @default(true) // « Reprendre le mois suivant » par défaut
  isTemplate     Boolean      @default(true) // utilisée quand un budget part des modèles
  sortOrder      Int          @default(0)
  fixed          Boolean      @default(false) // dépense de premier niveau : charge fixe (factures…) ou variable (courses…) ; les sous-catégories suivent leur parent
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  parent       Category?     @relation("CategoryTree", fields: [parentId, householdId, kind], references: [id, householdId, kind], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetItems  BudgetItem[]
  fixedCharges FixedCharge[]

  @@unique([id, householdId, kind])
  @@index([householdId])
  @@index([parentId])
}

// Budget prévisionnel d'un mois (au plus un par foyer et par mois). Ne crée jamais d'opération, ne touche aucun solde.
model Budget {
  id          String       @id @default(cuid())
  householdId String
  month       DateTime     @db.Date // 1er du mois (CHECK SQL)
  status      BudgetStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  household Household    @relation(fields: [householdId], references: [id])
  items     BudgetItem[]
  reports   Report[]

  @@unique([householdId, month])
}

// Ligne d'un budget : copie indépendante (libellé, montant…) ; `categoryId` ne sert qu'à rapprocher le réel.
// Un seul niveau de sous-lignes (trigger SQL), même budget et même sens que le parent (FK composite).
// Une ligne avec enfants vaut la somme de ses enfants inclus ; son montant direct reste 0.
model BudgetItem {
  id          String       @id @default(cuid())
  householdId String
  budgetId    String
  parentId    String?
  categoryId  String?
  kind        CategoryKind
  label       String
  amount      Int          @default(0) // centimes >= 0 (CHECK SQL)
  included    Boolean      @default(true)
  recurring   Boolean      @default(true)
  sortOrder   Int          @default(0)
  shared      Boolean      @default(true) // ligne commune (partagée au prorata)
  // Une seule réserve par budget : index unique partiel "BudgetItem_one_reserve" écrit à la main (migration 20261105000000_shared_split),
  // inexprimable en Prisma ; toute migration générée qui le supprime doit être corrigée à la main.
  reserve     Boolean      @default(false) // ligne « Réserve imprévus »
  createdAt   DateTime     @default(now())

  household Household    @relation(fields: [householdId], references: [id])
  budget    Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent    BudgetItem?  @relation("BudgetItemTree", fields: [parentId, budgetId, kind], references: [id, budgetId, kind], onDelete: Cascade)
  children  BudgetItem[] @relation("BudgetItemTree")
  category  Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([id, budgetId, kind])
  @@index([budgetId])
  @@index([parentId])
  @@index([categoryId])
}

// Récurrence mensuelle (revenu ou dépense) : échéance indicative, s'applique au mois M si active et startMonth <= M <= endMonth.
// Ne crée jamais de paiement toute seule : « marquer payée » crée l'opération sur action explicite.
model FixedCharge {
  id          String       @id @default(cuid())
  householdId String
  kind        CategoryKind @default(EXPENSE)
  active      Boolean      @default(true)
  name        String
  amount      Int // centimes, > 0 (CHECK SQL)
  dueDay      Int // 1–31 (CHECK SQL) ; échéance = min(jour, dernier jour du mois)
  accountId   String
  categoryId  String
  startMonth  DateTime     @db.Date // 1er du mois (CHECK SQL)
  endMonth    DateTime?    @db.Date // 1er du mois, >= startMonth (CHECK SQL)
  shared      Boolean      @default(true) // charge commune (partagée au prorata) ; forcé true sur un compte commun
  createdAt   DateTime     @default(now())

  household Household            @relation(fields: [householdId], references: [id])
  account   Account              @relation(fields: [accountId], references: [id])
  category  Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments  FixedChargePayment[]
  loan      Loan?

  @@index([householdId])
}

// Paiement d'une charge pour un mois : lié à la dépense créée ; supprimer la dépense supprime le paiement.
model FixedChargePayment {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String
  month         DateTime @db.Date // 1er du mois (CHECK SQL)
  transactionId String   @unique
  createdAt     DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([fixedChargeId, month])
  @@index([householdId, month])
}

// Crédit amortissable : porté par une charge fixe (nom, compte, catégorie, jour, période) ; échéancier calculé, jamais stocké.
model Loan {
  id            String   @id @default(cuid())
  householdId   String
  fixedChargeId String   @unique
  principal     Int // centimes, > 0 (CHECK SQL)
  annualRate    Int // millièmes de pour cent : 3,450 % → 3450 ; 0–50 000 (CHECK SQL)
  termMonths    Int // 1–600 échéances mensuelles (CHECK SQL)
  payment       Int? // mensualité saisie (hors assurance), > 0 (CHECK SQL) ; null = annuité calculée
  insurance     Int      @default(0) // assurance mensuelle, centimes, >= 0 (CHECK SQL)
  createdAt     DateTime @default(now())

  household   Household        @relation(fields: [householdId], references: [id])
  fixedCharge FixedCharge      @relation(fields: [fixedChargeId], references: [id], onDelete: Cascade)
  prepayments LoanPrepayment[]

  @@index([householdId])
}

// Remboursement anticipé : montant et date lus sur la dépense liée ; supprimer la dépense l'annule.
model LoanPrepayment {
  id            String         @id @default(cuid())
  householdId   String
  loanId        String
  transactionId String         @unique
  mode          PrepaymentMode
  createdAt     DateTime       @default(now())

  household   Household   @relation(fields: [householdId], references: [id])
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

// Rapport LLM d'un budget : `input` = chiffres envoyés, `output` = rapport validé, `error` si l'appel a échoué.
// Un seul rapport DAILY par foyer et par jour (index partiel SQL « Report_one_daily » sur (householdId, day) WHERE trigger = 'DAILY').
model Report {
  id          String        @id @default(cuid())
  householdId String
  budgetId    String
  userId      String? // auteur d'un rapport manuel
  day         DateTime      @db.Date
  trigger     ReportTrigger
  provider    LlmProvider
  model       String
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}
