generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum AccountKind {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

// Sens d'une ligne de virement : OUT débite le compte, IN le crédite.
enum TransferSide {
  OUT
  IN
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Règle de reconduction du prévisionnel d'un mois sur l'autre (appliquée par le cycle budget).
enum CarryOver {
  PREVIOUS // reprendre le montant du mois précédent
  FORECAST // repartir du prévisionnel
  NONE // à saisir chaque mois
}

model Household {
  id        String   @id @default(cuid())
  // Un seul foyer par instance : la colonne unique (+ CHECK = true) empêche un second setup concurrent.
  singleton Boolean  @unique @default(true)
  name      String
  currency  String   @default("EUR")
  timezone  String   @default("Europe/Paris")
  createdAt DateTime @default(now())

  users        User[]
  accounts     Account[]
  transactions Transaction[]
  categories   Category[]
  budgetLines  BudgetLine[]
}

model User {
  id           String   @id @default(cuid())
  householdId  String
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  sessions     Session[]
  transactions Transaction[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String      @id @default(cuid())
  householdId    String
  kind           AccountKind
  name           String
  initialBalance Int         @default(0)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  transactions Transaction[]

  @@index([householdId])
}

model Transaction {
  id           String          @id @default(cuid())
  householdId  String
  accountId    String
  createdById  String
  kind         TransactionKind
  amount       Int
  occurredOn   DateTime        @db.Date
  note         String?
  transferId   String?
  transferSide TransferSide?
  categoryId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id])
  account   Account   @relation(fields: [accountId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([transferId, transferSide])
  @@index([accountId, occurredOn])
  @@index([householdId])
  @@index([categoryId])
}

// Deux niveaux au plus (catégorie › sous-catégorie) ; sens et parent fixés à la création.
// Une sous-catégorie n'entre dans le budget que si elle ET son parent sont activés.
// Nom unique par (foyer, parent), insensible à la casse : index SQL brut dans la migration.
model Category {
  id             String       @id @default(cuid())
  householdId    String
  parentId       String?
  kind           CategoryKind
  name           String
  forecastAmount Int? // centimes, >= 0 (CHECK SQL)
  carryOver      CarryOver    @default(FORECAST)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetLines  BudgetLine[]

  @@index([householdId])
  @@index([parentId])
}

// Montant prévu d'une catégorie pour un mois : créé à la première ouverture du mois (reconduction), jamais réécrit ensuite.
model BudgetLine {
  id          String   @id @default(cuid())
  householdId String
  categoryId  String
  month       DateTime @db.Date // 1er du mois (CHECK SQL)
  planned     Int? // centimes, >= 0 (CHECK SQL) ; null = à saisir
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([householdId, month])
}
