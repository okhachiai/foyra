# Mot de passe PostgreSQL : à changer (lettres et chiffres uniquement, il est inséré dans une URL).
POSTGRES_PASSWORD=change-me-please
POSTGRES_USER=foyra
POSTGRES_DB=foyra

# Port publié sur l'hôte, et interface d'écoute (127.0.0.1 si un reverse proxy est sur la même machine).
APP_PORT=3000
APP_BIND=0.0.0.0

# URL publique (derrière un reverse proxy) : autorise cette origine pour les Server Actions. Lue au build.
APP_URL=
# true dès que l'application est servie en HTTPS (cookie de session « Secure »).
COOKIE_SECURE=false

# Base de test pour `npm test` (service db-test : docker compose --profile test up -d db-test)
DATABASE_URL_TEST=postgresql://foyra:foyra@localhost:5433/foyra_test
# Développement local (`npm run dev`) : pointez vers une base PostgreSQL accessible.
# DATABASE_URL=postgresql://foyra:foyra@localhost:5433/foyra_test

# Jeton exigé par l'assistant /setup (création du premier foyer et de l'admin). Vide = /setup ouvert au premier visiteur.
# Recommandé si l'instance est exposée avant son initialisation. Aucun mot de passe n'est codé en dur.
SETUP_TOKEN=

# Rapport LLM : un fournisseur n'est proposé que si ses variables sont renseignées.
# Claude (API Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Modèle local compatible OpenAI (Ollama, llama.cpp, LM Studio…) : URL sans /v1, ex. http://localhost:11434
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Jeton du déclencheur quotidien (appel HTTP externe, ex. cron) et horaire du rapport automatique.
CRON_TOKEN=
REPORT_CRON=
