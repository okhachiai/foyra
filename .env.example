# Mot de passe PostgreSQL : à changer (lettres et chiffres uniquement, il est inséré dans une URL).
POSTGRES_PASSWORD=change-me-please
POSTGRES_USER=foyra
POSTGRES_DB=foyra

# Port publié sur l'hôte, et interface d'écoute (127.0.0.1 si un reverse proxy est sur la même machine).
APP_PORT=3000
APP_BIND=0.0.0.0

# URL publique (derrière un reverse proxy) : autorise cette origine pour les Server Actions (lue au build),
# et signale le proxy : l'IP du client est alors lue dans X-Forwarded-For (limitation des connexions).
APP_URL=
# Cookie de session « Secure » : vide = déduit de APP_URL (https → Secure) ; true/false pour forcer.
COOKIE_SECURE=

# Base de test pour `npm test` (service db-test : docker compose --profile test up -d db-test)
DATABASE_URL_TEST=postgresql://foyra:foyra@localhost:5433/foyra_test
# Développement local (`npm run dev`) : pointez vers une base PostgreSQL accessible.
# DATABASE_URL=postgresql://foyra:foyra@localhost:5433/foyra_test

# Jeton exigé par l'assistant /setup (création du premier foyer et de l'admin).
# Vide = jeton aléatoire affiché dans les journaux du serveur (docker compose logs app). Aucun mot de passe n'est codé en dur.
SETUP_TOKEN=

# Rapport LLM : fournisseurs (Claude, modèle local) réglés dans l'application, Paramètres → Rapport LLM.
# Jeton du déclencheur quotidien (appel HTTP externe, ex. cron) et horaire du rapport automatique.
# Hexadécimal uniquement (recopié dans la crontab) : openssl rand -hex 32
CRON_TOKEN=
REPORT_CRON=
